+        costs = []
+        for group in groups:
+            lower, upper = np.percentile(midi[group], [1, 99])
+            lower_penalty = np.maximum(low-margin-(lower+12*shifts), 0)**2 if profile.get('raise_low_phrases', True) else np.zeros(len(shifts))
+            # Requested register wins over cross-line continuity when it fits;
+            # otherwise a single high line could drag every low verse down.
+            costs.append(lower_penalty + 6*np.maximum(upper+12*shifts-high-margin, 0)**2 + 8*np.abs(shifts))
+        scores = costs[0].copy()
+        backs = []
+        for cost in costs[1:]:
+            transition = scores[:,None] + 4*np.abs(shifts[:,None]-shifts[None,:])
+            backs.append(np.argmin(transition, axis=0))
+            scores = cost + np.min(transition, axis=0)
+        choice = int(np.argmin(scores)); stable_choices = [choice]
+        for back in reversed(backs):
