+                  'stable_register':stable,
+                  'boundary_margin_semitones':margin,'voiced_frames':len(voiced),'shifted_frames':int(np.sum(chosen!=0)),
+                  'repaired_spike_frames':int(repaired.sum()),'phrases':len(groups),
+                  'phrases_requiring_multiple_shifts':0,'phrases_exceeding_range':conflicts,
+                  'frames_outside_margin':int(outside.sum()),
