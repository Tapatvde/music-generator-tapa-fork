+import json
+import os
+from pathlib import Path
+from infer.voice_range import load_profile, profile_path, validate
+
+def model_path(name):
+    if not name or Path(name).name != name or not name.endswith('.pth'):
+        raise ValueError('Bitte ein vorhandenes Stimmprofil auswählen.')
+    path = Path(os.environ['weight_root']) / name
+    if not path.is_file():
+        raise ValueError('Modelldatei fehlt.')
+    return path
+
+def read_settings(name):
+    profile = load_profile(model_path(name))
+    if not profile:
+        return False, 'A2', 'C#4', 'Für dieses Modell ist noch keine Begrenzung gespeichert.'
+    return profile['enabled'], profile['min_note'], profile['max_note'], profile.get('description', 'Stimmumfang geladen.')
+
+def save_settings(name, enabled, minimum, maximum):
+    try:
+        path = model_path(name)
+        profile = load_profile(path) or {'schema_version': 1, 'mode':'octave_phrases', 'preserve_unvoiced':True}
+        profile.update(enabled=bool(enabled), min_note=str(minimum).strip(), max_note=str(maximum).strip())
+        validate(profile)
+        profile['description'] = 'Benutzerdefinierter Testbereich; die tatsächliche Singbarkeit ist durch Anhören zu prüfen.'
+        dest = profile_path(path)
+        temp = dest.with_suffix('.json.tmp')
+        temp.write_text(json.dumps(profile, ensure_ascii=False, indent=2), encoding='utf-8')
+        temp.replace(dest)
+        return f'Gespeichert: {minimum} bis {maximum}. Gilt ab der nächsten Umwandlung für dieses Modell.'
+    except (ValueError, KeyError, OSError) as error:
+        return 'Nicht gespeichert: ' + str(error)
