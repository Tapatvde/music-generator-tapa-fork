+
+def apply_section_registers(source, fallback, profile, regions, offset=0, padding=0):
+    """One octave shift per selected text section, applied to intact vocal phrases.
+
+    Select a whole phrase by greatest overlap; never switch inside a held note.
+    Low/middle/high are target registers, not guaranteed distinct octave choices.
+    """
+    source=np.asarray(source,dtype=np.float32);output=np.asarray(fallback).copy()
+    low,high=validate(profile);margin=float(profile.get('boundary_margin_semitones',1.))
+    voiced=np.flatnonzero(np.isfinite(source)&(source>0))
+    groups=np.split(voiced,np.flatnonzero(np.diff(voiced)>45)+1) if len(voiced) else []
+    times=np.arange(len(source))*.01-padding+offset
+    assigned={i:[] for i in range(len(regions))}
+    for group in groups:
+        overlaps=[int(np.sum((times[group]>=r['start'])&(times[group]<r['end']))) for r in regions]
+        if overlaps and max(overlaps)>0:
+            winner=int(np.argmax(overlaps))
+            if overlaps[winner]/len(group)>=.3:assigned[winner].append(group)
+    shifts=np.arange(-6,7);diagnostics=[];controlled=np.zeros(len(source),dtype=bool)
+    for index,region in enumerate(regions):
+        parts=assigned[index]
+        if not parts:continue
+        indices=np.concatenate(parts);notes=69+12*np.log2(source[indices]/440)
+        bottom,median,top=np.percentile(notes,[1,50,99])
+        center=float(profile.get('register_center_midi',(low+high)/2))
+        if not np.isfinite(center):raise ValueError('Ungültige mittlere Tonlagenreferenz.')
+        center=float(np.clip(center,low,high))
+        target={'low':low+(center-low)*.4,'middle':center,'high':center+(high-center)*.6}[region['level']]
+        distance=np.abs(median+12*shifts-target)
+        fits=(bottom+12*shifts>=low-margin)&(top+12*shifts<=high+margin)
+        ideal=int(np.argmin(distance));conflict=not fits.any()
+        if fits.any():choice=int(np.argmin(np.where(fits,distance,np.inf)))
+        else:
+            penalty=6*np.maximum(top+12*shifts-high-margin,0)**2+np.maximum(low-margin-bottom-12*shifts,0)**2
+            choice=int(np.argmin(penalty+distance*.25))
+        shift=int(region.get('octave_shift',shifts[choice]))
+        # A full-song plan keeps previews and full versions in the same octave.
+        output[indices]=source[indices]*np.exp2(float(shift));controlled[indices]=True
+        conflict=bool(bottom+12*shift<low-margin or top+12*shift>high+margin)
+        diagnostics.append({'section':region['section'],'tag':region['tag'],'level':region['level'],
+            'octave_shift':shift,'source_median_midi':float(median),'output_median_midi':float(median+12*shift),
+            'target_midi':float(target),'range_conflict':bool(conflict),'range_limited':shift!=int(shifts[ideal]),
+            'phrase_times':[{'start':float(times[p[0]]),'end':float(times[p[-1]]+.01)} for p in parts]})
+    output[source<=0]=0
+    return output,diagnostics,controlled
+
+
+def repair_octaves(f0, reference, confidence, isolated_runs=False):
+    """Require independent confident evidence before correcting octave errors."""
+    values=np.asarray(f0).copy()
+    valid=(values>0)&(reference>0)&(confidence>=.85)
+    delta=np.zeros(len(values));delta[valid]=12*np.log2(reference[valid]/values[valid])
+    octaves=np.round(delta/12).astype(int)
+    evidence=valid & (np.abs(octaves)>=1)&(np.abs(octaves)<=2)&(np.abs(delta-12*octaves)<1.)
+    correction=np.zeros(len(values),dtype=int)
+    # Require three consecutive reference frames, avoiding isolated PM errors.
+    for k in [-2,-1,1,2]:
+        ids=np.flatnonzero(evidence & (octaves==k))
+        if not len(ids):continue
+        for run in np.split(ids,np.flatnonzero(np.diff(ids)>1)+1):
+            if len(run)<3:continue
+            correction[run]=k
+            # Fill uncertain <=80ms edges of the same pitch plateau. Confident
+            # contradictory reference evidence stops propagation.
+            for edge,direction in [(run[0],-1),(run[-1],1)]:
+                for step in range(1,9):
+                    j=edge+direction*step;prev=j-direction
+                    if j<0 or j>=len(values) or values[j]<=0:break
+                    if abs(12*np.log2(values[j]/values[prev]))>4:break
+                    if valid[j] and (not evidence[j] or octaves[j]!=k):break
+                    correction[j]=k
+    values*=np.exp2(correction.astype(float))
+    islands=[]
+    if isolated_runs:
+        voiced=np.flatnonzero(values>0)
+        runs=np.split(voiced,np.flatnonzero(np.diff(voiced)>1)+1) if len(voiced) else []
+        for i in range(1,len(runs)-1):
+            run=runs[i];left=runs[i-1];right=runs[i+1]
+            if not 3<=len(run)<=20 or run[0]-left[-1]>30 or right[0]-run[-1]>30:continue
+            a=float(np.median(69+12*np.log2(values[left[-8:]]/440)))
+            b=float(np.median(69+12*np.log2(values[right[:8]]/440)))
+            middle=69+12*np.log2(values[run]/440)
+            if abs(a-b)<=3 and np.percentile(middle,10)>max(a,b)+7:
+                values[run]=440*np.exp2((np.linspace(a,b,len(run)+2)[1:-1]-69)/12)
+                islands.append({'start_frame':int(run[0]),'end_frame':int(run[-1]),'frames':len(run)})
+    return values,{'reference_octave_corrected_frames':int(np.sum(correction!=0)),
+                   'isolated_high_runs_repaired':islands,'island_correction_changes_melody':bool(islands)}
