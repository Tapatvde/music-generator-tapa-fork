diff --git a/infer/voice_range.py b/infer/voice_range.py
new file mode 100644
--- /dev/null
+++ b/infer/voice_range.py
@@ -0,0 +1,302 @@
+"""Optional per-model singing range applied to the F0 sent to the synthesizer."""
+import json
+from pathlib import Path
+import re
+import numpy as np
+
+NOTES = ('C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B')
+
+def note_midi(text):
+    match = re.fullmatch(r'([A-Ga-g])([#b]?)(-?\d)', str(text).strip())
+    if not match:
+        raise ValueError('Ton bitte als A2, C#4 oder Bb3 angeben; C4 ist das mittlere C.')
+    letter, accidental, octave = match.groups()
+    return 12*(int(octave)+1) + {'C':0,'D':2,'E':4,'F':5,'G':7,'A':9,'B':11}[letter.upper()] + {'':0,'#':1,'b':-1}[accidental]
+
+def midi_note(value):
+    n = int(value)
+    return NOTES[n % 12] + str(n//12-1)
+
+def validate(profile):
+    if not isinstance(profile, dict) or not isinstance(profile.get('enabled', False), bool):
+        raise ValueError('Ungültiges Stimmumfangsprofil.')
+    low, high = note_midi(profile['min_note']), note_midi(profile['max_note'])
+    if low < 32 or high > 84 or high-low < 12:
+        raise ValueError('Grenzen müssen zwischen G#1 und C6 liegen und mindestens eine Oktave umfassen, damit Oktavversetzungen in der Tonart bleiben.')
+    if profile.get('mode', 'octave_phrases') not in ('octave_phrases', 'melody_phrases'):
+        raise ValueError('Unbekannter Begrenzungsmodus.')
+    if profile.get('mode') == 'melody_phrases':
+        margin = profile.get('boundary_margin_semitones', 1.)
+        if not isinstance(margin, (int, float)) or not np.isfinite(margin) or not 0 <= margin <= 2:
+            raise ValueError('Übergangsspielraum muss zwischen 0 und 2 Halbtönen liegen.')
+    if profile.get('octave_reference') not in (None,'pm'):
+        raise ValueError('Unbekannte Referenz für die Oktavprüfung.')
+    for flag in ['raise_low_phrases','repair_isolated_high_runs','stable_register']:
+        if flag in profile and not isinstance(profile[flag],bool):
+            raise ValueError('Ungültiger Schalter im Stimmprofil: '+flag)
+    return low, high
+
+def profile_path(model):
+    return Path(model).with_suffix('.voice.json')
+
+def load_profile(model):
+    path = profile_path(model)
+    if not path.exists():
+        return None
+    profile = json.loads(path.read_text(encoding='utf-8-sig'))
+    validate(profile)
+    return profile
+
+def apply_range(f0, profile):
+    """Keep zeros; use one octave shift per phrase wherever its entire span fits."""
+    if profile.get('mode') == 'melody_phrases':
+        return apply_melody_range(f0, profile)
+    values = np.asarray(f0).copy()
+    low, high = validate(profile)
+    voiced = np.flatnonzero(np.isfinite(values) & (values > 0))
+    if not profile['enabled'] or not len(voiced):
+        return values, {'enabled': profile['enabled'], 'shifted_frames': 0}
+    midi = 69 + 12*np.log2(values[voiced]/440)
+    shifts = np.arange(-6, 7)
+    chosen = np.zeros(len(voiced), dtype=int)
+    groups = np.split(np.arange(len(voiced)), np.flatnonzero(np.diff(voiced)>12)+1)
+    split_phrases = 0
+    for group in groups:
+        notes = midi[group]
+        candidate = notes[:,None] + 12*shifts
+        valid = (candidate >= low-1e-7) & (candidate <= high+1e-7)
+        if not valid.any(axis=1).all():
+            raise ValueError('Tonhöhe liegt außerhalb der unterstützten Oktavversetzungen.')
+        whole = np.flatnonzero(valid.all(axis=0))
+        if len(whole):
+            choice = whole[np.argmin(np.abs(shifts[whole]))]
+            chosen[group] = shifts[choice]
+            continue
+        split_phrases += 1
+        # When one shift cannot fit a wide phrase, penalize register changes;
+        # changing at a note transition is preferable to changing during a held note.
+        unary = .002*np.abs(shifts)
+        costs = np.where(valid[0], unary, np.inf)
+        back = np.zeros((len(notes), len(shifts)), dtype=np.int8)
+        distance = np.abs(shifts[:,None]-shifts[None,:])
+        for i in range(1, len(notes)):
+            penalty = .15 if abs(notes[i]-notes[i-1])>.8 else 1.5
+            if voiced[group[i]]-voiced[group[i-1]]>1:
+                penalty = .05
+            matrix = costs[:,None] + penalty*distance
+            back[i] = np.argmin(matrix,axis=0)
+            costs = np.where(valid[i], np.min(matrix,axis=0)+unary, np.inf)
+        choice = int(np.argmin(costs))
+        for i in range(len(notes)-1, -1, -1):
+            chosen[group[i]] = shifts[choice]
+            choice = int(back[i,choice])
+    values[voiced] *= np.exp2(chosen.astype(float))
+    result_midi = 69+12*np.log2(values[voiced]/440)
+    assert result_midi.min() >= low-1e-5 and result_midi.max() <= high+1e-5
+    return values, {'enabled': True, 'min_note': profile['min_note'], 'max_note':profile['max_note'],
+                    'voiced_frames':len(voiced), 'shifted_frames':int(np.sum(chosen!=0)),
+                    'phrases':len(groups), 'phrases_requiring_multiple_shifts':split_phrases,
+                    'shift_octaves_counts':{str(n):int(np.sum(chosen==n)) for n in np.unique(chosen)},
+                    'output_min_midi':float(result_midi.min()),'output_max_midi':float(result_midi.max())}
+
+def apply_melody_range(f0, profile):
+    """Prefer intact melodic phrases over an impossible hard range guarantee.
+
+    A constant octave per phrase preserves intervals and key. If a phrase is
+    wider than the available range, report the conflict rather than fold notes.
+    Only very brief spikes surrounded by similar pitches are repaired.
+    """
+    values = np.asarray(f0).copy()
+    low, high = validate(profile)
+    voiced = np.flatnonzero(np.isfinite(values) & (values > 0))
+    if not profile['enabled'] or not len(voiced):
+        return values, {'enabled':profile['enabled'], 'shifted_frames':0}
+    midi = 69+12*np.log2(values[voiced]/440)
+    repaired = np.zeros(len(voiced), dtype=bool)
+    # Never compare neighbours across a pause. Repair <=80ms spikes or <=200ms
+    # near-exact octave errors bracketed by agreeing notes, retaining longer steps.
+    for run in np.split(np.arange(len(voiced)), np.flatnonzero(np.diff(voiced)>1)+1):
+        notes = midi[run].copy()
+        for i in range(1,len(run)-1):
+            if repaired[run[i]]:
+                continue
+            for width in range(min(20,len(run)-i-1),0,-1):
+                left = notes[max(0,i-4):i]
+                right = notes[i+width:min(len(run),i+width+4)]
+                if len(left)<3 or len(right)<3:
+                    continue
+                a,b = float(np.median(left)),float(np.median(right))
+                if abs(a-b)>3:
+                    continue
+                target = np.linspace(a,b,width+2)[1:-1]
+                residual=notes[i:i+width]-target
+                octave=np.round(residual/12)
+                octave_error=np.all((np.abs(octave)>=1)&(np.abs(residual-12*octave)<2.5))
+                if np.all(np.abs(residual)>7) and (width<=8 or octave_error):
+                    indices=run[i:i+width]
+                    midi[indices]=target
+                    repaired[indices]=True
+                    break
+    stable = profile.get('stable_register', False)
+    groups=np.split(np.arange(len(voiced)),np.flatnonzero(np.diff(voiced)>(45 if stable else 30))+1)
+    margin=float(profile.get('boundary_margin_semitones',1.))
+    shifts=np.arange(-6,7)
+    # If neighbouring vocal runs genuinely occupy different registers, only
+    # reconsider the shift at an existing >=80ms unvoiced break, never mid-note.
+    refined=[]
